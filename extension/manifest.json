{
  "manifest_version": 3,
  "name": "Richmack Browser OS",
  "version": "0.3.0",
  "description": "A subtle, toolbar-first Richmack layer for Chromium with workspaces, smart bookmarks, extraction and safe browser automation.",
  "permissions": [
    "activeTab",
    "bookmarks",
    "downloads",
    "scripting",
    "sidePanel",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Richmack",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "commands": {
    "toggle-richmack-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Toggle Richmack keyboard mode"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
