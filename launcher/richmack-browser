#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CHROMIUM="/Applications/Chromium.app/Contents/MacOS/Chromium"
if [ ! -x "$CHROMIUM" ]; then
  echo "Richmack Browser requires Chromium at /Applications/Chromium.app"
  echo "Install it with: brew install --cask chromium"
  exit 1
fi
PROFILE="$HOME/.richmack/browser-profile-v050"
mkdir -p "$PROFILE"
EXTS="$(printf '%s,' "$ROOT"/extensions/* | sed 's/,$//')"
exec "$CHROMIUM" \
  --user-data-dir="$PROFILE" \
  --load-extension="$EXTS" \
  --disable-extensions-except="$EXTS" \
  --no-first-run \
  --no-default-browser-check \
  "$@"
