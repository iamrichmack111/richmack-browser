#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="${HOME}/.richmack/browser-profile"
EXT="${ROOT}/extension"
mkdir -p "$PROFILE"

find_chromium() {
  local candidates=(
    "/Applications/Chromium.app/Contents/MacOS/Chromium"
    "$HOME/Applications/Chromium.app/Contents/MacOS/Chromium"
  )
  for c in "${candidates[@]}"; do
    [[ -x "$c" ]] && { printf '%s\n' "$c"; return 0; }
  done
  for c in chromium chromium-browser; do
    command -v "$c" >/dev/null 2>&1 && { command -v "$c"; return 0; }
  done
  return 1
}

BROWSER="${RICHMACK_CHROMIUM:-$(find_chromium || true)}"
if [[ -z "$BROWSER" ]]; then
  cat >&2 <<'MSG'
Richmack Browser: Chromium was not found.
macOS Homebrew install: brew install --cask chromium
Richmack intentionally does not fall back to Google Chrome.
MSG
  exit 1
fi

exec "$BROWSER" \
  --user-data-dir="$PROFILE" \
  --load-extension="$EXT" \
  --no-first-run \
  --disable-sync \
  --disable-background-networking \
  --disable-component-update \
  "$@"
