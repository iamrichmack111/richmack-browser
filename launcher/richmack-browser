#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROFILE="$HOME/.richmack/browser-profile-v054"
DEFAULT="$PROFILE/Default"
PREFS="$DEFAULT/Preferences"
mkdir -p "$DEFAULT"

if [ "$(uname -s)" = "Darwin" ]; then
  CHROMIUM="/Applications/Chromium.app/Contents/MacOS/Chromium"
  if [ ! -x "$CHROMIUM" ] && [ -x "$HOME/Applications/Chromium.app/Contents/MacOS/Chromium" ]; then
    CHROMIUM="$HOME/Applications/Chromium.app/Contents/MacOS/Chromium"
  fi
else
  CHROMIUM=""
  for c in chromium chromium-browser; do
    if command -v "$c" >/dev/null 2>&1; then CHROMIUM="$(command -v "$c")"; break; fi
  done
fi

if [ -z "${CHROMIUM:-}" ] || [ ! -x "$CHROMIUM" ]; then
  echo "Richmack Browser requires Chromium."
  if [ "$(uname -s)" = "Darwin" ]; then
    echo "Install with: brew install --cask chromium"
  else
    echo "Ubuntu: sudo snap install chromium"
  fi
  exit 1
fi

# Seed only a new profile. Chromium owns this file after first launch.
if [ ! -s "$PREFS" ]; then
  cat > "$PREFS" <<'JSON'
{
  "extensions": {
    "pinned_by_default": true,
    "ui": {"developer_mode": true}
  },
  "browser": {"check_default_browser": false}
}
JSON
fi

EXTS="$(printf '%s,' "$ROOT"/extensions/* | sed 's/,$//')"
exec "$CHROMIUM" \
  --user-data-dir="$PROFILE" \
  --load-extension="$EXTS" \
  --disable-extensions-except="$EXTS" \
  --force-dark-mode \
  --enable-features=WebUIDarkMode \
  --no-first-run \
  --no-default-browser-check \
  "$@"
